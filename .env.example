# Mvalex Business Suite - Environment Variables

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mvalex?schema=public"

# Redis (for caching and queues)
REDIS_URL="redis://localhost:6379"

# NextAuth.js
NEXTAUTH_URL="http://localhost:5001"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# OpenAI
OPENAI_API_KEY=""

# File Storage (AWS S3 or MinIO for local dev)
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="mvalex-assets"
S3_ENDPOINT="http://localhost:9000"
S3_FORCE_PATH_STYLE="true"

# Email (SendGrid)
SENDGRID_API_KEY=""
FROM_EMAIL="noreply@mvalex.com"

# App Config
NODE_ENV="development"
APP_NAME="Mvalex Business Suite"
APP_URL="http://localhost:5001"

# Credits (default values)
DEFAULT_USER_CREDITS="50"
LOGO_GENERATION_COST="20"
BUSINESS_CARD_GENERATION_COST="5"
INVOICE_GENERATION_COST="3"
EXPORT_COST="2"
AI_ASSISTANT_COST="1"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
